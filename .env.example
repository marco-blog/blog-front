# front 서버 설정 예시. 복사해서 .env로 쓰고, .env는 커밋하지 않는다.

# backend 주소. /api/**, /media/** 등 프록시 대상이자 SSR loader가 직접 호출하는 주소
BLOG_BACKEND_URL=http://localhost:8080

# front 서버 포트
PORT=5173

# 사이트의 공개 주소(scheme+host). SSR이 backend에 보내는 POST(토큰 갱신·조회수)의 Origin으로 쓴다.
# 비우면 들어온 요청의 주소를 쓴다. backend의 blog.base-url과 같아야 한다.
BLOG_PUBLIC_URL=http://localhost:5173

# Kakao JavaScript 키(카카오톡 공유 버튼). Kakao Developers의 앱 > 플랫폼 키 > JavaScript 키를 넣고,
# 그 앱의 Web 플랫폼 사이트 도메인에 서비스 주소를 등록한다. 비우면 카카오톡 공유 버튼을 숨긴다.
BLOG_KAKAO_JS_KEY=
